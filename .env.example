# Copy this file to `.env.local` and fill in your Supabase values.
# Find them in Supabase: Project Settings -> API Keys (and Data API for the URL).
#
# Only the PUBLISHABLE key (starts with sb_publishable_) or the legacy "anon"
# key goes here. It is safe in the browser because Row Level Security
# controls what it can do.
#
# NEVER put the secret / service_role key here. The app refuses to start with it.
#
# Leave both empty to run the app with built-in fictional sample data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
